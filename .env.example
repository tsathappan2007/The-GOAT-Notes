# THE G.O.A.T. Notes - Environment Variables Template
# Copy this file to '.env' and fill in your keys.
# Since this is a client-side Vite app, all variables must be prefixed with VITE_.

# 1. AI Completion API Key (Groq key starting with gsk_ or Anthropic key starting with sk-ant-)
VITE_ANTHROPIC_API_KEY=your_groq_or_claude_api_key_here

# 2. GitHub Personal Access Token (Optional, but recommended to avoid rate limits)
VITE_GITHUB_PAT=your_github_pat_here

# 3. Custom CORS Proxy API Endpoint (Optional)
VITE_CUSTOM_ENDPOINT=
